#!/bin/sh
# mount system-folders
# =============================
/bin/mount -t proc none /proc
/bin/mount -t sysfs none /sys
/bin/mount -t devtmpfs none /dev

# prepare support for virtual filesystem for OpenSSH
mkdir -p /dev/pts
/bin/mount -t devpts devpts /dev/pts


# some startup-things
# =============================
# set hostname
hostname -F /etc/hostname

# syslog into a 128 KiB RAM ring buffer (ptp4l logs there); read with "logread -f"
syslogd -C128

# read mac-address from SD-card and set it
/openx32/x32sdconfig

# bring networkdevices up
ip link set lo up
ip link set eth0 up
# The PHY link comes up only a few seconds after this point. With the busybox
# defaults (3 tries, then 20 s pause) the lease arrived ~30 s after boot;
# retry quicker instead.
udhcpc -i eth0 -b -t 10 -T 2 -A 5

# AES67 (FPGA core on the control bus, SPI3 chip-select 0, spibone driver):
# "/etc/init.d/aes67 start" once OMC has loaded the gateware and set the bus
# online, "/etc/init.d/aes67 stop" before the FPGA is reconfigured. Not started
# here: OMC loads the bitstream later.

# start user-shells
# =============================
# start a shell for serial-port (MIDI-In/Out)
echo "Starting shell for ttymxc4..."
/sbin/getty -L 115200 ttymxc4 &

# start dropbear with auto-key-creation
/openx32/dropbear -B  > /dev/null 2>&1 &

while true; do
	# start OpenX32 Main-Software as Shell
	/bin/setsid /bin/cttyhack /openx32/omc --L /openx32/lattice.bit --X /openx32/xilinx.bit --D1 /openx32/dsp1.ldr --D2 /openx32/dsp2.ldr

	# start a simple shell for tty0 (Display)
	echo "Booting into busybox shell..."
	# try to make the current shell a controlling terminal
	/bin/setsid /bin/cttyhack /bin/sh

	echo "Shell exited. Restarting in 1 second..."
	sleep 1
done
